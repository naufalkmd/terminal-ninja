<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>terminalninja</id>
    <version>1.0.0</version>
    <title>TerminalNinja 🥷</title>
    <authors>naufalkmd</authors>
    <owners>naufalkmd</owners>
    <licenseUrl>https://github.com/naufalkmd/terminal-ninja/blob/main/LICENSE</licenseUrl>
    <projectUrl>https://github.com/naufalkmd/terminal-ninja</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>
      TerminalNinja - Apply one terminal identity across PowerShell, bash, zsh, and WSL.
      
      Features:
      - Shared Starship prompt across shells
      - PowerShell PSReadLine with predictive IntelliSense
      - bash/zsh history, completion, aliases, and helper functions
      - Automatic profile wiring for Windows and WSL startup files
      - Managed install under ~/.terminal-ninja
    </description>
    <summary>TerminalNinja - One prompt and workflow across PowerShell, bash, zsh, and WSL</summary>
    <releaseNotes>Use Starship as the shared prompt layer across PowerShell, bash, zsh, and WSL</releaseNotes>
    <tags>powershell bash zsh wsl profile terminal starship psreadline autocomplete git</tags>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>

