{
  "version": "1.0.1",
  "description": "Shared Starship prompt and shell-native terminal workflow across PowerShell, bash, zsh, and WSL",
  "homepage": "https://github.com/naufalkmd/terminal-ninja",
  "license": "MIT",
  "url": "https://github.com/naufalkmd/terminal-ninja/archive/refs/tags/v1.0.1.zip",
  "hash": "cd874b561d08753af2ff0bf37237ff1c3774cd5622287e4c6459f1c5d6d96679",
  "extract_dir": "terminal-ninja-1.0.1",
  "depends": "starship",
  "suggest": {
    "PowerShell": "powershell-core"
  },
  "installer": {
    "script": [
      "& pwsh -NoProfile -ExecutionPolicy Bypass -File \"$dir\\tools\\chocolateyinstall.ps1\" -Targets powershell,bash,zsh,cmd"
    ]
  },
  "uninstaller": {
    "script": [
      "& pwsh -NoProfile -ExecutionPolicy Bypass -File \"$dir\\tools\\chocolateyuninstall.ps1\""
    ]
  },
  "checkver": {
    "github": "https://github.com/naufalkmd/terminal-ninja"
  },
  "autoupdate": {
    "url": "https://github.com/naufalkmd/terminal-ninja/archive/refs/tags/v$version.zip",
    "extract_dir": "terminal-ninja-$version"
  }
}